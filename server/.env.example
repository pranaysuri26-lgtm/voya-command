# Copy this to server/.env for local development
# On Railway, set these as environment variables in the dashboard

# PostgreSQL connection string (Railway provides this automatically)
DATABASE_URL=postgresql://user:password@localhost:5432/voya_command

# Anthropic API key
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# JWT secret (use a long random string in production)
JWT_SECRET=change-me-in-production

# Claude model override (optional)
# CLAUDE_MODEL=claude-sonnet-4-6

# CORS allowed origin (set to your Electron app's origin or * for dev)
# CLIENT_ORIGIN=*
